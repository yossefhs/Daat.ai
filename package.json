{
  "name": "daat-ai",
  "version": "0.2.0",
  "description": "Daat Torah — Plateforme d'étude halakhique avec assistant IA",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/extract-corpus.js && npm run build:js",
    "vercel-build": "node scripts/extract-corpus.js && npm run build:js",
    "build:js": "terser assets/js/chat-widget.js -c passes=2 -m --comments=false -o assets/js/chat-widget.min.js",
    "rav:weekly-pack": "node scripts/rav-weekly-pack.js",
    "rav:review": "node scripts/rav-review.js",
    "test:rav": "node --test tests/rav-content-engine.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@upstash/redis": "^1.34.3",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.0.0",
    "unpdf": "^0.12.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "terser": "^5.48.0"
  }
}
