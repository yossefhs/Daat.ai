{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Admin-Secret" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/api/auth/send-code", "destination": "/api/auth?action=send-code" },
    { "source": "/api/auth/verify-code", "destination": "/api/auth?action=verify-code" },
    { "source": "/api/auth/me", "destination": "/api/auth?action=me" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },

    { "source": "/oh", "destination": "/sources/shabbat/index.html" },
    { "source": "/oh/", "destination": "/sources/shabbat/index.html" },
    { "source": "/oh/:n(\\d+)", "destination": "/sources/shabbat/siman-:n/index.html" },
    { "source": "/oh/:n(\\d+)/", "destination": "/sources/shabbat/siman-:n/index.html" },
    { "source": "/oh/:n(\\d+)/base", "destination": "/sources/shabbat/siman-:n/niveau-1-base.html" },
    { "source": "/oh/:n(\\d+)/base/", "destination": "/sources/shabbat/siman-:n/niveau-1-base.html" },
    { "source": "/oh/:n(\\d+)/lamdan", "destination": "/sources/shabbat/siman-:n/niveau-2-lamdan.html" },
    { "source": "/oh/:n(\\d+)/lamdan/", "destination": "/sources/shabbat/siman-:n/niveau-2-lamdan.html" },
    { "source": "/oh/:n(\\d+)/synthese", "destination": "/sources/shabbat/siman-:n/niveau-3-synthese.html" },
    { "source": "/oh/:n(\\d+)/synthese/", "destination": "/sources/shabbat/siman-:n/niveau-3-synthese.html" },
    { "source": "/oh/:n(\\d+)/daat-harav", "destination": "/sources/shabbat/siman-:n/niveau-4-daat-harav.html" },
    { "source": "/oh/:n(\\d+)/daat-harav/", "destination": "/sources/shabbat/siman-:n/niveau-4-daat-harav.html" }
  ],

  "redirects": [
    { "source": "/sources/shabbat", "destination": "/oh/", "permanent": true },
    { "source": "/sources/shabbat/", "destination": "/oh/", "permanent": true },
    { "source": "/sources/shabbat/index.html", "destination": "/oh/", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)", "destination": "/oh/:n/", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/", "destination": "/oh/:n/", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/index.html", "destination": "/oh/:n/", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/niveau-1-base.html", "destination": "/oh/:n/base", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/niveau-2-lamdan.html", "destination": "/oh/:n/lamdan", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/niveau-3-synthese.html", "destination": "/oh/:n/synthese", "permanent": true },
    { "source": "/sources/shabbat/siman-:n(\\d+)/niveau-4-daat-harav.html", "destination": "/oh/:n/daat-harav", "permanent": true },

    { "source": "/oh/siman-:n(\\d+)", "destination": "/oh/:n/", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/", "destination": "/oh/:n/", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/index.html", "destination": "/oh/:n/", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/niveau-1-base.html", "destination": "/oh/:n/base", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/niveau-2-lamdan.html", "destination": "/oh/:n/lamdan", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/niveau-3-synthese.html", "destination": "/oh/:n/synthese", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/niveau-4-daat-harav.html", "destination": "/oh/:n/daat-harav", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/base", "destination": "/oh/:n/base", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/lamdan", "destination": "/oh/:n/lamdan", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/synthese", "destination": "/oh/:n/synthese", "permanent": true },
    { "source": "/oh/siman-:n(\\d+)/daat-harav", "destination": "/oh/:n/daat-harav", "permanent": true },

    { "source": "/oh/:n(\\d+)/index.html", "destination": "/oh/:n/", "permanent": true },
    { "source": "/oh/:n(\\d+)/niveau-1-base.html", "destination": "/oh/:n/base", "permanent": true },
    { "source": "/oh/:n(\\d+)/niveau-2-lamdan.html", "destination": "/oh/:n/lamdan", "permanent": true },
    { "source": "/oh/:n(\\d+)/niveau-3-synthese.html", "destination": "/oh/:n/synthese", "permanent": true },
    { "source": "/oh/:n(\\d+)/niveau-4-daat-harav.html", "destination": "/oh/:n/daat-harav", "permanent": true }
  ],

  "functions": {
    "api/chat.js": { "maxDuration": 300 },
    "api/conversations.js": { "maxDuration": 10 },
    "api/feedback.js": { "maxDuration": 5 },

    "api/auth.js": { "maxDuration": 10 },
    "api/newsletter.js": { "maxDuration": 60 },
    "api/khavroutha.js": { "maxDuration": 10 },
    "api/soutenir.js": { "maxDuration": 10 },

    "api/admin/corpus.js": { "maxDuration": 10 },
    "api/admin/upload-pdf.js": { "maxDuration": 30 },
    "api/admin/transcribe-photos.js": { "maxDuration": 90 },
    "api/admin/generate-siman.js": { "maxDuration": 300 },
    "api/admin/feedback.js": { "maxDuration": 5 },
    "api/admin/stats.js": { "maxDuration": 15 }
  },

  "crons": [
    {
      "path": "/api/newsletter",
      "schedule": "0 9 * * *"
    }
  ]
}
