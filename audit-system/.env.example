# Configuration du système d'audit — copier en `.env` (jamais commité).

# Mode : audit_readonly (Phase 1) | staging_review | production_publish
AUDIT_MODE=audit_readonly

# SQLite (défaut) ou PostgreSQL :
# AUDIT_DATABASE_URL=postgresql+psycopg2://daat_audit:motdepasse@localhost:5432/daat_audit
AUDIT_DATABASE_URL=sqlite:///./var/daat_audit.db

# Périmètre MVP
AUDIT_SIMAN_START=242
AUDIT_SIMAN_END=269

# Politesse du crawler
AUDIT_CRAWL_DELAY_SECONDS=1.5

# Derrière un proxy TLS d'entreprise, pointer vers le faisceau CA :
# AUDIT_CA_BUNDLE=/chemin/vers/ca-bundle.crt
